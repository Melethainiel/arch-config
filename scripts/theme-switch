#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'usage: theme-switch /path/to/wallpaper|theme-name\n' >&2
}

theme_dir() {
  local name="$1"
  local script_dir

  script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

  if [[ -d "$HOME/.config/arch-config/themes/$name" ]]; then
    printf '%s\n' "$HOME/.config/arch-config/themes/$name"
  elif [[ -d "$script_dir/../themes/$name" ]]; then
    printf '%s\n' "$script_dir/../themes/$name"
  else
    return 1
  fi
}

write_hyprpaper_config() {
  local hyprpaper_config="$config_home/hypr/hyprpaper.conf"

  {
    printf '# Generated by theme-switch.\nipc = on\npreload = %s\n' "$wallpaper"

    printf '\nwallpaper {\n    monitor =\n    path = %s\n}\n' "$wallpaper"
  } > "$hyprpaper_config"
}

preset_wallpaper() {
  local source_dir="$1"
  local candidate

  shopt -s nullglob
  for candidate in "$source_dir"/*.png "$source_dir"/*.jpg "$source_dir"/*.jpeg "$source_dir"/*.webp; do
    printf '%s\n' "$candidate"
    shopt -u nullglob
    return 0
  done
  shopt -u nullglob
  return 1
}

sync_pixie_sddm_wallpaper() {
  local pixie_dir="/usr/share/sddm/themes/pixie"
  local extension lowered_extension background_target background_value

  [[ -d "$pixie_dir" ]] || return 0

  extension="${wallpaper##*.}"
  lowered_extension="${extension,,}"
  background_target="$pixie_dir/assets/background-current.$lowered_extension"
  background_value="assets/background-current.$lowered_extension"

  if [[ -w "$pixie_dir/assets" && -w "$pixie_dir/theme.conf" ]]; then
    install -Dm644 "$wallpaper" "$background_target"
    sed -i "s#^background=.*#background=$background_value#" "$pixie_dir/theme.conf"
    return 0
  fi

  if command -v sudo >/dev/null 2>&1; then
    sudo install -Dm644 "$wallpaper" "$background_target"
    sudo sed -i "s#^background=.*#background=$background_value#" "$pixie_dir/theme.conf"
    return 0
  fi

  printf 'warning: unable to sync wallpaper to Pixie SDDM theme\n' >&2
}

confirm_theme_overwrite() {
  local answer

  if [[ ! -f "$config_home/ags/theme.css" ]] \
    && [[ ! -f "$config_home/swaync/theme.css" ]] \
    && [[ ! -f "$config_home/hypr/theme.lua" ]] \
    && [[ ! -f "$config_home/hypr/theme.conf" ]] \
    && [[ ! -f "$config_home/ghostty/theme.conf" ]] \
    && [[ ! -f "$config_home/ghostty/themes/Matugen" ]] \
    && [[ ! -f "$config_home/btop/themes/current.theme" ]] \
    && [[ ! -f "$config_home/fuzzel/fuzzel.ini" ]] \
    && [[ ! -f "$config_home/gtk-3.0/gtk.css" ]] \
    && [[ ! -f "$config_home/gtk-4.0/gtk.css" ]] \
    && [[ ! -f "$config_home/Code/User/settings.json" ]]; then
    return 0
  fi

  read -r -p "A theme is already applied. Replace it? [y/N] " answer

  case "$answer" in
    [Yy]|[Yy][Ee][Ss]) return 0 ;;
    *) return 1 ;;
  esac
}

install_theme_dirs() {
  install -d \
    "$config_home/ags" \
    "$config_home/swaync" \
    "$config_home/hypr" \
    "$config_home/ghostty" \
    "$config_home/ghostty/themes" \
    "$config_home/btop/themes" \
    "$config_home/fuzzel" \
    "$config_home/gtk-3.0" \
    "$config_home/gtk-4.0" \
    "$config_home/Code/User" \
    "$config_home/opencode"
}

ensure_btop_current_theme() {
  local btop_config="$config_home/btop/btop.conf"

  if [[ ! -f "$btop_config" ]]; then
    install -d "$(dirname "$btop_config")"
    printf 'color_theme = "current"\n' >"$btop_config"
    return 0
  fi

  if grep -q '^color_theme = ' "$btop_config"; then
    sed -i 's|^color_theme = .*|color_theme = "current"|' "$btop_config"
  else
    sed -i '1acolor_theme = "current"' "$btop_config"
  fi
}

ensure_ghostty_theme_include() {
  local ghostty_config="$config_home/ghostty/config"
  local include='config-file = ?"~/.config/ghostty/theme.conf"'

  if [[ ! -f "$ghostty_config" ]]; then
    return 0
  fi

  if grep -q '^theme = ' "$ghostty_config"; then
    sed -i "s|^theme = .*|$include|" "$ghostty_config"
  elif ! grep -q '^config-file = ?"~/.config/ghostty/theme.conf"$' "$ghostty_config"; then
    sed -i "1a$include" "$ghostty_config"
  fi
}

restart_themed_components() {
  if command -v hyprctl >/dev/null 2>&1; then
    hyprctl reload >/dev/null 2>&1 || true
  fi

  if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.interface color-scheme prefer-dark >/dev/null 2>&1 || true
  fi

  if command -v ags >/dev/null 2>&1; then
    ags quit --instance arch-shell >/dev/null 2>&1 || true
    pkill -x ags >/dev/null 2>&1 || true
    sleep 1
    ags run "$config_home/ags/app.tsx" >/tmp/arch-config-ags.log 2>&1 &
  fi

  if command -v swaync >/dev/null 2>&1; then
    pkill -x swaync >/dev/null 2>&1 || true
    swaync >/tmp/arch-config-swaync.log 2>&1 &
  fi

  pkill -SIGUSR2 ghostty >/dev/null 2>&1 || true
  pkill -SIGUSR2 btop >/dev/null 2>&1 || true
  pkill -SIGUSR2 opencode >/dev/null 2>&1 || true
}

apply_theme_preset() {
  local name="$1"
  local source_dir="$2"
  local preset_background

  install_theme_dirs

  if ! confirm_theme_overwrite; then
    printf 'Theme unchanged.\n'
    exit 0
  fi

  install -Dm644 "$source_dir/ags-theme.css" "$config_home/ags/theme.css"
  install -Dm644 "$source_dir/swaync-theme.css" "$config_home/swaync/theme.css"
  install -Dm644 "$source_dir/hyprland-theme.lua" "$config_home/hypr/theme.lua"
  rm -f "$config_home/hypr/theme.conf"
  install -Dm644 "$source_dir/ghostty.conf" "$config_home/ghostty/theme.conf"
  install -Dm644 "$source_dir/ghostty.conf" "$config_home/ghostty/themes/${name^}"
  install -Dm644 "$source_dir/btop.theme" "$config_home/btop/themes/current.theme"
  install -Dm644 "$source_dir/fuzzel.ini" "$config_home/fuzzel/fuzzel.ini"
  install -Dm644 "$source_dir/gtk.css" "$config_home/gtk-3.0/gtk.css"
  install -Dm644 "$source_dir/gtk.css" "$config_home/gtk-4.0/gtk.css"
  install -Dm644 "$source_dir/vscode.json" "$config_home/Code/User/settings.json"
  install -Dm644 "$source_dir/opencode.json" "$config_home/opencode/opencode.json"
  ensure_btop_current_theme
  ensure_ghostty_theme_include

  if [[ "$name" == "nord" ]] && command -v code >/dev/null 2>&1; then
    code --install-extension arcticicestudio.nord-visual-studio-code >/dev/null 2>&1 || true
  fi

  if preset_background="$(preset_wallpaper "$source_dir")"; then
    wallpaper="$(realpath "$preset_background")"
    write_hyprpaper_config
    sync_pixie_sddm_wallpaper

    if command -v hyprctl >/dev/null 2>&1; then
      hyprctl hyprpaper preload "$wallpaper" >/dev/null 2>&1 || true
      hyprctl hyprpaper wallpaper ",$wallpaper" >/dev/null 2>&1 || true
    fi
  fi

  restart_themed_components
  printf 'Theme applied: %s\n' "$name"
}

if [[ "${1:-}" == "" ]]; then
  usage
  exit 2
fi

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"

if preset_dir="$(theme_dir "$1")"; then
  apply_theme_preset "$1" "$preset_dir"
  exit 0
fi

wallpaper="$1"
if [[ ! -f "$wallpaper" ]]; then
  printf 'error: wallpaper or theme not found: %s\n' "$wallpaper" >&2
  exit 1
fi

if ! command -v matugen >/dev/null 2>&1; then
  printf 'error: matugen is not installed\n' >&2
  exit 1
fi

wallpaper="$(realpath "$wallpaper")"
matugen_config="$config_home/matugen/config.toml"

install_theme_dirs

if [[ ! -f "$matugen_config" ]]; then
  printf 'error: matugen config not found: %s\n' "$matugen_config" >&2
  printf 'run ./install.sh first to install dotfiles/matugen into ~/.config/matugen\n' >&2
  exit 1
fi

if ! confirm_theme_overwrite; then
  printf 'Theme unchanged.\n'
  exit 0
fi

matugen image "$wallpaper" -m dark -c "$matugen_config"
rm -f "$config_home/hypr/theme.conf"
ensure_btop_current_theme
ensure_ghostty_theme_include

write_hyprpaper_config
sync_pixie_sddm_wallpaper

if command -v hyprctl >/dev/null 2>&1; then
  hyprctl hyprpaper preload "$wallpaper" >/dev/null 2>&1 || true
  hyprctl hyprpaper wallpaper ",$wallpaper" >/dev/null 2>&1 || true
fi

restart_themed_components

printf 'Theme generated from %s\n' "$wallpaper"
