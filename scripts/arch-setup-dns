#!/usr/bin/env bash
set -euo pipefail

provider="${1:-}"

if [[ -z "$provider" ]]; then
  printf 'Usage: %s Cloudflare|Quad9|DHCP\n' "$(basename "$0")" >&2
  exit 1
fi

configure_resolved_link() {
  sudo systemctl enable --now systemd-resolved.service
  sudo ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf
}

write_resolved() {
  sudo tee /etc/systemd/resolved.conf >/dev/null
  configure_resolved_link
  sudo systemctl restart systemd-resolved.service
}

case "$provider" in
  Cloudflare)
    write_resolved <<'EOF'
[Resolve]
DNS=1.1.1.1#cloudflare-dns.com 1.0.0.1#cloudflare-dns.com 2606:4700:4700::1111#cloudflare-dns.com 2606:4700:4700::1001#cloudflare-dns.com
FallbackDNS=9.9.9.9#dns.quad9.net 149.112.112.112#dns.quad9.net 2620:fe::fe#dns.quad9.net 2620:fe::9#dns.quad9.net
DNSOverTLS=opportunistic
EOF
    ;;
  Quad9)
    write_resolved <<'EOF'
[Resolve]
DNS=9.9.9.9#dns.quad9.net 149.112.112.112#dns.quad9.net 2620:fe::fe#dns.quad9.net 2620:fe::9#dns.quad9.net
FallbackDNS=1.1.1.1#cloudflare-dns.com 1.0.0.1#cloudflare-dns.com 2606:4700:4700::1111#cloudflare-dns.com 2606:4700:4700::1001#cloudflare-dns.com
DNSOverTLS=opportunistic
EOF
    ;;
  DHCP)
    write_resolved <<'EOF'
[Resolve]
DNSOverTLS=no
EOF
    ;;
  *)
    printf 'Unknown DNS provider: %s\n' "$provider" >&2
    exit 1
    ;;
esac

printf 'DNS configured with %s.\n' "$provider"
read -r -n 1 -s -p "Press any key to close..."
printf '\n'
